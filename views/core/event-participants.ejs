<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="container" style="padding-top: 2rem; padding-bottom: 4rem;">
  <div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
    <a href="/core/dashboard" class="btn btn-sm btn-outline">&larr; Back to Core Dashboard</a>
    <button class="btn btn-sm btn-primary" onclick="openModal('editEventModal')">
      ⚙️ Edit Event Details & Venue
    </button>
  </div>

  <div class="card" style="margin-bottom: 2rem; border-top: 4px solid var(--secondary);">
    <div class="card-body">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
        <div>
          <span class="badge badge-category"><%= event.category %></span>
          <h1 style="font-size: 1.75rem; font-weight: 800; color: var(--primary); margin-top: 0.25rem;">
            <%= event.title %>
          </h1>
          <p style="font-size: 0.95rem; color: var(--text-muted);">
            📍 Venue: <strong><%= event.venue %></strong> &bull; 🕒 <%= new Date(event.eventDate).toLocaleDateString() %> (<%= event.startTime %> - <%= event.endTime %>)
          </p>
        </div>
        <div style="text-align: right;">
          <div style="font-size: 1.5rem; font-weight: 800; color: var(--primary);">
            <%= event.participants.length %> / <%= event.maxParticipants %>
          </div>
          <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase;">Students Registered</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Participants Table -->
  <div class="section-header">
    <div>
      <h2 class="section-title">📝 Registered Participants Roster</h2>
      <p class="section-subtitle">Click the check-in button to mark student attendance on event day</p>
    </div>
  </div>

  <% if (event.participants.length === 0) { %>
    <div style="text-align: center; padding: 3rem 1rem; background: #fff; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
      <h3 style="color: var(--primary); font-size: 1.25rem; margin-bottom: 0.5rem;">No registrations yet</h3>
      <p style="color: var(--text-muted);">Students who register online on ClubSphere will appear on this check-in sheet automatically.</p>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Student Name</th>
            <th>Roll Number</th>
            <th>Department</th>
            <th>Email & Phone</th>
            <th>Registered Time</th>
            <th>Attendance Status</th>
          </tr>
        </thead>
        <tbody>
          <% event.participants.forEach((p, idx) => { %>
            <tr>
              <td>
                <strong><%= p.name %></strong>
              </td>
              <td>
                <span style="font-weight: 700; color: var(--primary);"><%= p.rollNo %></span>
              </td>
              <td style="font-size: 0.85rem;"><%= p.department || 'ClubSphere' %></td>
              <td style="font-size: 0.85rem;">
                <%= p.email %><br>
                <span style="color: var(--text-muted);"><%= p.phone || 'N/A' %></span>
              </td>
              <td style="font-size: 0.8rem; color: var(--text-muted);">
                <%= new Date(p.registeredAt).toLocaleDateString() %>
              </td>
              <td>
                <button 
                  type="button" 
                  class="btn btn-sm <%= p.attended ? 'btn-success' : 'btn-outline' %>"
                  onclick="toggleAttendance('<%= event._id %>', '<%= p._id %>', this)"
                >
                  <%= p.attended ? '✓ Present' : 'Mark Present' %>
                </button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

  <!-- Modal: Edit Event Details for Core Member -->
  <div class="modal-overlay" id="editEventModal">
    <div class="modal-box" style="max-width: 600px;">
      <div class="modal-header">
        <h3 class="modal-title">Update Event Details & Venue</h3>
        <button class="modal-close" onclick="closeModal('editEventModal')">✕</button>
      </div>
      <form action="/core/events/<%= event._id %>/update" method="POST">
        <div class="modal-body">
          <div class="form-group">
            <label for="venue">Event Venue / Lab *</label>
            <input type="text" id="venue" name="venue" class="form-control" value="<%= event.venue %>" required>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="eventDate">Event Date *</label>
              <input type="date" id="eventDate" name="eventDate" class="form-control" value="<%= event.eventDate.toISOString().substring(0, 10) %>" required>
            </div>
            <div class="form-group">
              <label for="status">Event Status</label>
              <select id="status" name="status" class="form-control">
                <option value="Upcoming" <%= event.status === 'Upcoming' ? 'selected' : '' %>>Upcoming</option>
                <option value="Ongoing" <%= event.status === 'Ongoing' ? 'selected' : '' %>>Ongoing</option>
                <option value="Completed" <%= event.status === 'Completed' ? 'selected' : '' %>>Completed</option>
                <option value="Cancelled" <%= event.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="startTime">Start Time</label>
              <input type="text" id="startTime" name="startTime" class="form-control" value="<%= event.startTime %>">
            </div>
            <div class="form-group">
              <label for="endTime">End Time</label>
              <input type="text" id="endTime" name="endTime" class="form-control" value="<%= event.endTime %>">
            </div>
          </div>

          <div class="form-group">
            <label for="description">Event Description Updates</label>
            <textarea id="description" name="description" class="form-control" style="min-height: 90px;"><%= event.description %></textarea>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-outline" onclick="closeModal('editEventModal')">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Updates &rarr;</button>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
