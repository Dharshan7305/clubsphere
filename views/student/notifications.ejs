<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="container" style="padding-top: 2rem; padding-bottom: 4rem;">
  <div class="section-header">
    <div>
      <h1 class="section-title">🔔 Club Notifications & Alerts</h1>
      <p class="section-subtitle">Real-time alerts for recruitment drives, event updates, and application progress</p>
    </div>
  </div>

  <% if (notifications.length === 0) { %>
    <div style="text-align: center; padding: 4rem 1rem; background: #fff; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
      <h3 style="color: var(--primary); font-size: 1.35rem; margin-bottom: 0.5rem;">No notifications right now</h3>
      <p style="color: var(--text-muted);">You're all caught up with campus club news!</p>
    </div>
  <% } else { %>
    <div style="display: flex; flex-direction: column; gap: 1rem; max-width: 850px; margin: 0 auto;">
      <% notifications.forEach(notif => { %>
        <div class="card notif-card <%= notif.isRead ? 'read' : '' %>" style="border-left: 4px solid <%= notif.type === 'application' ? 'var(--secondary)' : (notif.type === 'event' ? 'var(--accent)' : 'var(--success)') %>;">
          <div class="card-body" style="padding: 1.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.4rem;">
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 1.2rem;">
                  <%= notif.type === 'application' ? '📋' : (notif.type === 'event' ? '🎟️' : (notif.type === 'recruitment' ? '⚡' : '📢')) %>
                </span>
                <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--primary);">
                  <%= notif.title %>
                </h3>
              </div>
              <% if (!notif.isRead) { %>
                <span class="badge badge-open notif-status">Unread</span>
              <% } %>
            </div>

            <p style="font-size: 0.92rem; color: #334155; line-height: 1.6; margin-bottom: 0.75rem;">
              <%= notif.message %>
            </p>

            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.825rem; color: var(--text-muted); border-top: 1px solid var(--border-color); padding-top: 0.6rem;">
              <span>🕒 <%= new Date(notif.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>

              <div style="display: flex; gap: 8px;">
                <% if (!notif.isRead) { %>
                  <button type="button" class="btn btn-sm btn-outline" onclick="markAsRead('<%= notif._id %>', this)">
                    Mark as Read
                  </button>
                <% } %>
                <% if (notif.relatedLink && notif.relatedLink !== '#') { %>
                  <a href="<%= notif.relatedLink %>" class="btn btn-sm btn-primary">
                    View Details &rarr;
                  </a>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
