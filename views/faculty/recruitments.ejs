<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="container" style="padding-top: 2rem; padding-bottom: 4rem;">
  <div class="section-header">
    <div>
      <h1 class="section-title">⚡ Faculty Recruitment Oversight</h1>
      <p class="section-subtitle">History of all recruitment drives and approval logs for <%= club.name %></p>
    </div>
    <a href="/faculty/dashboard" class="btn btn-outline">&larr; Back to Portal</a>
  </div>

  <% if (recruitments.length === 0) { %>
    <div style="text-align: center; padding: 4rem 1rem; background: #fff; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
      <h3 style="color: var(--primary); font-size: 1.35rem; margin-bottom: 0.5rem;">No recruitment records found</h3>
    </div>
  <% } else { %>
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      <% recruitments.forEach(rec => { %>
        <div class="card">
          <div class="card-header">
            <div>
              <span class="badge <%= rec.status === 'Open' ? 'badge-open' : (rec.status === 'Pending Approval' ? 'badge-coming-soon' : 'badge-closed') %>"><%= rec.status %></span>
              <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--primary); margin-top: 0.25rem;"><%= rec.title %></h2>
            </div>
            <div style="font-size: 0.85rem; color: var(--text-muted);">
              Deadline: <strong><%= new Date(rec.deadline).toLocaleDateString() %></strong>
            </div>
          </div>
          <div class="card-body">
            <p style="font-size: 0.9rem; margin-bottom: 0.5rem;"><strong>Academic Year:</strong> <%= rec.academicYear %></p>
            <p style="font-size: 0.9rem; margin-bottom: 0.75rem;"><strong>Eligibility:</strong> <%= rec.eligibility %></p>

            <div style="background: #f8fafc; border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 0.75rem 1rem; font-size: 0.85rem;">
              <div><strong>Faculty Approval Decision:</strong> <span class="badge <%= rec.facultyApproval.status === 'Approved' ? 'badge-open' : (rec.facultyApproval.status === 'Pending' ? 'badge-coming-soon' : 'badge-rejected') %>"><%= rec.facultyApproval.status %></span></div>
              <div style="margin-top: 0.25rem;"><strong>Remarks:</strong> <%= rec.facultyApproval.remarks || 'None' %></div>
              <% if (rec.facultyApproval.reviewedAt) { %>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.25rem;">Reviewed on: <%= new Date(rec.facultyApproval.reviewedAt).toLocaleString() %></div>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
